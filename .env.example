# ─── Core ────────────────────────────────────────────────────────────────
# Public base URL (no trailing slash) – used for canonical URLs, sitemap, OG tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL (Supabase: use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL)
DATABASE_URL="postgresql://drugplus:drugplus@localhost:5432/drugplus?schema=public"
DIRECT_URL="postgresql://drugplus:drugplus@localhost:5432/drugplus?schema=public"

# Admin session signing secret – generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Initial admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# Salt used to hash visitor IPs stored with leads (privacy) – any random string
IP_HASH_SALT="another-random-string"

# ─── Spam protection (Cloudflare Turnstile) ──────────────────────────────
# Leave empty to disable (honeypot + rate limit still apply)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Analytics (all optional; loaded only after cookie consent) ──────────
NEXT_PUBLIC_GA4_ID=""             # G-XXXXXXX
NEXT_PUBLIC_GTM_ID=""             # GTM-XXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_CLARITY_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""      # AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=""  # conversion label for lead submissions

# ─── CRM / lead routing (all optional – every enabled target receives each lead) ──
# Generic webhook (Zapier, Make, n8n, custom). Signed with HMAC-SHA256 in X-Signature header.
LEAD_WEBHOOK_URL=""
LEAD_WEBHOOK_SECRET=""

# Google Sheets via an Apps Script web-app URL (see README → CRM integrations)
GOOGLE_SHEETS_WEBHOOK_URL=""

# HubSpot private app token (scope: crm.objects.contacts.write)
HUBSPOT_ACCESS_TOKEN=""

# Zoho CRM (OAuth refresh-token flow)
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_ACCOUNTS_URL="https://accounts.zoho.in"
ZOHO_API_DOMAIN="https://www.zohoapis.in"

# WhatsApp Business Cloud API – notify the sales team on every new lead
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_NOTIFY_TO=""             # e.g. 919999999999
WHATSAPP_TEMPLATE_NAME=""         # approved template with 3 body params (name, phone, interest); leave empty to send plain text (24h window only)

# ─── Uploads ─────────────────────────────────────────────────────────────
# Local disk directory (served at /uploads/*). On serverless hosts (Vercel) paste URLs from an object store instead – see README.
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB="10"
